rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in ['tam.app83@gmail.com', 'tm.app83@gmail.com', 'tamteach01@gmail.com', 'admin@tam.com']
      );
    }

    // ── Admins ────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false; // Only Firebase Console / server SDK
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Each user can read/write ONLY their own document.
    // Admins have full access (for dashboard management).
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      // Admins have full update rights; regular users can only update their own non-sensitive fields
      allow update: if isAdmin() || (isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['is_blocked', 'is_admin', 'role', 'is_subscribed']));
      allow delete: if isOwner(userId) || isAdmin(); // Required for Apple 5.1.1 and Admin deletion

      // ── Progress subcollection ──────────────────────────────────────────
      match /progress/{lessonId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // ── Quiz Results subcollection ──────────────────────────────────────
      match /quiz_results/{resultId} {
        allow read:           if isOwner(userId) || isAdmin();
        allow create:         if isOwner(userId);
        allow update:         if isAdmin();
        allow delete:         if isOwner(userId) || isAdmin(); // account deletion
      }
    }

    // ── Subscriptions ─────────────────────────────────────────────────────
    // Users can READ their own subscriptions and CREATE one for themselves
    // right after a successful store purchase (validated shape, id = store
    // transaction id, so it can't be overwritten). They can never update or
    // delete. Admins (dashboard) and Cloud Functions (Admin SDK) manage the rest.
    match /subscriptions/{subId} {
      allow read:   if (isAuth() && resource.data.firebase_uid == request.auth.uid) || isAdmin();
      allow create: if isAdmin() || (
                      isAuth()
                      && request.resource.data.firebase_uid == request.auth.uid
                      && request.resource.data.status == 'active'
                      && request.resource.data.plan in ['tam_6months_12kwd', 'tam_6months', 'tam_3months', 'tam_1month', 'tam_1year']
                      && request.resource.data.duration_days is int
                      && request.resource.data.duration_days <= 365
                      && request.resource.data.created == request.time
                      && request.resource.data.keys().hasOnly([
                           'user_email', 'firebase_uid', 'plan', 'product_id', 'platform',
                           'transaction_id', 'status', 'duration_days', 'start_date',
                           'end_date', 'created'])
                    );
      allow update, delete: if isAdmin();
    }

    // ── Grades ────────────────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Subjects ──────────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Lessons ───────────────────────────────────────────────────────────
    // Note: subscription check at Firestore Rules level would require
    // a cross-collection lookup which is expensive. The subscription gate
    // is enforced at the app UI level. If you want strict enforcement,
    // migrate lesson delivery to a Cloud Function that checks subscription first.
    match /lessons/{lessonId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── PDFs ──────────────────────────────────────────────────────────────
    match /pdfs/{pdfId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Countries (public config) ─────────────────────────────────────────
    match /countries/{countryId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Global Config (AI settings, etc.) ─────────────────────────────────
    match /config/{configId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Rate Limit Counters (Firestore-backed, server-side only) ─────────
    // Rate limits are now managed by Cloud Functions using Admin SDK.
    // Clients can no longer read or write rate limit documents directly,
    // preventing any bypass of the rate limiting system.
    match /rate_limits/{userId} {
      allow read, write: if false; // Cloud Functions (Admin SDK) only
    }
  }
}

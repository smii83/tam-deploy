rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Admins ────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false; // Only Firebase Console / server SDK
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Each user can read/write ONLY their own document.
    // Admins can read any user document (for dashboard).
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Prevent clients from writing sensitive admin-only fields
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['is_blocked', 'is_admin', 'role', 'is_subscribed']);
      allow delete: if isOwner(userId); // Required for Apple 5.1.1 account deletion

      // ── Progress subcollection ──────────────────────────────────────────
      match /progress/{lessonId} {
        allow read, write: if isOwner(userId);
      }

      // ── Quiz Results subcollection ──────────────────────────────────────
      match /quiz_results/{resultId} {
        allow read:          if isOwner(userId);
        allow create:        if isOwner(userId);
        allow update, delete: if false; // Immutable once saved
      }
    }

    // ── Subscriptions ─────────────────────────────────────────────────────
    // Clients can only READ their own subscriptions.
    // ALL writes (create/update/delete) are done exclusively by Cloud Functions
    // using Firebase Admin SDK — which bypasses these rules entirely.
    // This prevents any client from fraudulently activating a subscription.
    match /subscriptions/{subId} {
      allow read:             if isAuth() && resource.data.firebase_uid == request.auth.uid;
      allow create, update:   if false; // Cloud Functions (Admin SDK) only
      allow delete:           if false; // Cloud Functions (Admin SDK) only
    }

    // ── Grades ────────────────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Subjects ──────────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Lessons ───────────────────────────────────────────────────────────
    // Note: subscription check at Firestore Rules level would require
    // a cross-collection lookup which is expensive. The subscription gate
    // is enforced at the app UI level. If you want strict enforcement,
    // migrate lesson delivery to a Cloud Function that checks subscription first.
    match /lessons/{lessonId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── PDFs ──────────────────────────────────────────────────────────────
    match /pdfs/{pdfId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Countries (public config) ─────────────────────────────────────────
    match /countries/{countryId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Rate Limit Counters (Firestore-backed, server-side only) ─────────
    // Rate limits are now managed by Cloud Functions using Admin SDK.
    // Clients can no longer read or write rate limit documents directly,
    // preventing any bypass of the rate limiting system.
    match /rate_limits/{userId} {
      allow read, write: if false; // Cloud Functions (Admin SDK) only
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && (
        (request.auth.token.email != null &&
         request.auth.token.email in ['tam.app83@gmail.com', 'tm.app83@gmail.com', 'tamteach01@gmail.com', 'admin@tam.com', 'admin@eduspark.com']) ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    function isSubscribed() {
      return isAuth() && (
        isAdmin() ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.is_subscribed == true)
      );
    }

    // Videos: read if subscribed or admin, write admin only
    match /videos/{allPaths=**} {
      allow read: if isSubscribed();
      allow write: if isAdmin();
    }

    // PDFs: read if authenticated or admin, write admin only
    match /pdfs/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Interactive-lesson narration (MP3) — generated by Cloud Functions
    match /lesson_audio/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}

